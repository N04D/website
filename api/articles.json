---
layout: null
permalink: /api/articles.json
---
{
  "site": {{ site.url | jsonify }},
  "language": "nl",
  "articles": [
    {% for post in site.posts %}{
      "title": {{ post.title | jsonify }},
      "url": {{ post.url | absolute_url | jsonify }},
      "description": {{ post.description | default: post.excerpt | strip_html | strip_newlines | jsonify }},
      "datePublished": {{ post.date | date: '%Y-%m-%d' | jsonify }},
      "dateModified": {{ post.last_modified_at | default: post.date | date: '%Y-%m-%d' | jsonify }},
      "project_id": {{ post.project_id | default: '' | jsonify }},
      "category": {{ post.category | default: '' | jsonify }}
    }{% unless forloop.last %},{% endunless %}
    {% endfor %}
  ]
}
